# Supabase Postgres. The pooled URL is used at runtime; the direct URL is used
# for migrations. Prisma is pinned to 6.19 because Prisma 7 breaks this pattern
# in favour of driver adapters (spec §12).
#
# The quotes below are dotenv syntax and belong ONLY in this file. Pasting a
# value into Vercel's environment-variable box keeps the quotes literally, so
# the value becomes "postgresql://... — a scheme Prisma does not recognise, and
# the build dies on P1013. In Vercel, paste the bare URL: no quotes, no
# leading DATABASE_URL=, nothing but the connection string itself.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Both URLs should come from Supabase's Connect panel, ORMs tab, Prisma. Take
# them from the POOLER, not the db.<ref>.supabase.co direct host: that host is
# IPv6-only on new projects and a Vercel build container generally cannot reach
# it, so `prisma migrate deploy` fails there even with a well-formed URL.
#   DATABASE_URL -> transaction pooler, port 6543
#   DIRECT_URL   -> session pooler, port 5432
# Replace [YOUR-PASSWORD] with the real password (brackets and all), and
# URL-encode any of @ : / ? # & it contains.

# Supabase Auth (allowlisted Google sign-in — one user, no roles, no RLS).
# The anon key is what Supabase now labels "Publishable key" (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# The one address allowed to sign in. Anything else is refused.
ALLOWED_EMAIL="you@example.com"
