# Supabase Postgres. The pooled URL is used at runtime; the direct URL is used
# for migrations. Prisma is pinned to 6.19 because Prisma 7 breaks this pattern
# in favour of driver adapters (spec §12).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (allowlisted Google sign-in — one user, no roles, no RLS).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# The one address allowed to sign in. Anything else is refused.
ALLOWED_EMAIL="you@example.com"
