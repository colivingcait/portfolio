// Data model (§11).
//
// Money is stored as integer cents everywhere. Percentages are Decimal, never
// Float — an ownership stack that drifts by a rounding error stops summing to
// 100%. Dates that are calendar dates (statement periods, loan terms,
// ownership windows) are stored as @db.Date.
//
// Prisma is pinned to 6.19: Prisma 7 breaks the pooled/direct URL pattern in
// favour of driver adapters (§12).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgBouncer) — used at runtime
  directUrl = env("DIRECT_URL") // direct — used for migrations
}

// ── Ownership ────────────────────────────────────────────────────────────────

enum EntityKind {
  person
  company
}

/// A node in the ownership graph. People and legal entities are the same kind
/// of node; only `kind` distinguishes them.
model Entity {
  id        String     @id @default(cuid())
  kind      EntityKind
  name      String
  /// The single user's own node. Exactly one entity should carry this.
  isViewer  Boolean    @default(false)
  taxId     String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  interestsHeld  OwnershipInterest[]   @relation("InterestOwner")
  interestsIn    OwnershipInterest[]   @relation("InterestOwnedEntity")
  propertiesHeld Property[]            @relation("PropertyTitleEntity")
  capitalEntries CapitalAccountEntry[]

  @@index([kind])
}

enum OwnedType {
  property
  entity
}

enum OwnershipBasis {
  equity
  distribution
}

/// owner holds X% of owned, where owned is a property or another entity.
///
/// Every interest is dated: a partner buying in or out is a new record, not an
/// edit that silently rewrites history (§3).
model OwnershipInterest {
  id                  String         @id @default(cuid())
  ownerId             String
  ownedType           OwnedType
  /// Set when ownedType = property.
  propertyId          String?
  /// Set when ownedType = entity.
  ownedEntityId       String?
  /// Whole-number percentage: 50.0 means 50%.
  percent             Decimal        @db.Decimal(9, 6)
  /// Overrides equity for cash calculations. Empty means cash follows equity.
  distributionPercent Decimal?       @db.Decimal(9, 6)
  startDate           DateTime       @db.Date
  endDate             DateTime?      @db.Date
  basis               OwnershipBasis @default(equity)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner       Entity    @relation("InterestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ownedEntity Entity?   @relation("InterestOwnedEntity", fields: [ownedEntityId], references: [id], onDelete: Cascade)

  @@index([ownerId, startDate])
  @@index([propertyId])
  @@index([ownedEntityId])
}

enum CapitalEntryKind {
  /// Money the owner put in. Owed back on sale, and not a loan: it accrues no
  /// interest and appears in no maturity ladder.
  contribution
  /// A share of profit paid out. Does not reduce what is owed back.
  distribution
  /// Capital handed back. This is what reduces the outstanding balance.
  return_of_capital
}

/// Who funded, as opposed to who owns. Where contributions have been uneven —
/// one partner covering a repair, another a down payment — this ledger is the
/// only way effective economics stay honest (§3).
model CapitalAccountEntry {
  id          String           @id @default(cuid())
  entityId    String
  propertyId  String?
  kind        CapitalEntryKind
  date        DateTime         @db.Date
  /// The earnings month a profit distribution relates to, as YYYY-MM. A
  /// distribution paid in October for September is recorded against September,
  /// so a month's split can be checked against that month's net cash.
  month       String?
  amountCents Int
  memo        String?
  createdAt   DateTime         @default(now())

  entity   Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([entityId, date])
  @@index([propertyId, date])
}

// ── Portfolio ────────────────────────────────────────────────────────────────

enum RevenueSource {
  /// Revenue arrives via monthly CSV import.
  padsplit
  /// Revenue arrives as deposits in the bank statement, categorized on import.
  direct
}

enum UnitStructure {
  rooms
  units
}

enum PropertyStatus {
  acquiring
  ramping
  stabilized
  divesting
  sold
}

model Property {
  id                 String         @id @default(cuid())
  name               String
  addressLine1       String?
  city               String?
  state              String?
  postalCode         String?
  /// PadSplit PSID. Null for properties that have nothing to do with PadSplit.
  externalId         String?        @unique
  /// Which legal owner holds title. Every report is filterable by entity.
  titleEntityId      String
  revenueSource      RevenueSource
  unitStructure      UnitStructure
  status             PropertyStatus @default(stabilized)
  roomCount          Int?
  unitCount          Int?
  acquiredOn         DateTime?      @db.Date
  /// What the property cost. Reference for the accountant, and the starting
  /// point for basis.
  purchasePriceCents Int?
  /// The money that actually left your pocket: deposit, closing costs and
  /// rehab. This is the denominator of cash-on-cash, and it is NOT the
  /// purchase price — financing the rest is the whole point.
  cashInvestedCents  Int?
  disposedOn         DateTime?      @db.Date
  /// The §1 property table is carried from an earlier build document and is
  /// NOT yet verified. Nothing renders as fact until someone confirms the
  /// address, room count and status and sets this.
  dataVerified       Boolean        @default(false)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  titleEntity        Entity                  @relation("PropertyTitleEntity", fields: [titleEntityId], references: [id])
  units              Unit[]
  rooms              Room[]
  managementPeriods  ManagementPeriod[]
  leases             Lease[]
  bankAccounts       BankAccount[]
  loans              Loan[]
  ownershipInterests OwnershipInterest[]
  valuations         Valuation[]
  capitalEntries     CapitalAccountEntry[]
  summaryLines       SummaryLine[]
  billedLines        BilledLine[]
  collectionLines    CollectionLine[]
  monthlyRollups     MonthlyPropertyRollup[]
  pmStatements       PMStatement[]

  @@index([titleEntityId])
  @@index([status])
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  label      String
  bedrooms   Int?
  bathrooms  Decimal? @db.Decimal(4, 1)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]
  leases   Lease[]

  @@unique([propertyId, label])
}

model Room {
  id         String  @id @default(cuid())
  propertyId String
  unitId     String?
  label      String
  /// PadSplit Room ID, as it appears in the collected export.
  externalId String?
  active     Boolean @default(true)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([propertyId, label])
  @@index([externalId])
}

enum ManagementMode {
  self
  pm
}

enum FeeBasis {
  gross_collected
  host_earnings
  net_billed
}

/// A property's management arrangement is a dated record, not a property-level
/// setting (§4). The engine looks up the period covering an earnings month and
/// applies the matching identity — historical months then compute correctly
/// with no PM fee, without a special case anywhere in the code.
model ManagementPeriod {
  id          String         @id @default(cuid())
  propertyId  String
  startDate   DateTime       @db.Date
  endDate     DateTime?      @db.Date
  mode        ManagementMode
  managerName String?
  /// Whole-number percentage: 10.5 means 10.5%.
  feePercent  Decimal?       @db.Decimal(6, 3)
  feeBasis    FeeBasis?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startDate])
}

/// A minimal lease record makes expected-vs-received computable for direct
/// properties, giving the duplex the same vacancy and collection figures the
/// coliving houses get (§7).
model Lease {
  id                String    @id @default(cuid())
  propertyId        String
  unitId            String?
  tenantName        String
  rentCents         Int
  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date
  depositHeldCents  Int       @default(0)
  utilitiesIncluded Boolean   @default(false)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId, startDate])
}

// ── PadSplit ledger (§6) ─────────────────────────────────────────────────────
//
// Everything is keyed by EARNINGS MONTH — the month the rent was for — never
// payout month. Months are stored as 'YYYY-MM'.

model PadSplitImport {
  id            String   @id @default(cuid())
  /// summary | billed | collected | earnings_table
  fileKind      String
  fileName      String
  rowCount      Int
  /// Months the file touched, comma separated, for showing what it replaced.
  monthsCovered String
  importedAt    DateTime @default(now())

  summaryLines    SummaryLine[]
  billedLines     BilledLine[]
  collectionLines CollectionLine[]
  monthTotals     PadSplitMonthTotal[]

  @@index([fileKind])
}

/// One property per earnings month, straight off summary.csv.
///
/// Verified against a real export: gross + booking fees = net of booking fees,
/// + service fees = host earnings, + adjustments = total payout. Every column
/// is stored rather than derived, so a future export that breaks one of those
/// identities is visible instead of silently absorbed.
model SummaryLine {
  id                 String  @id @default(cuid())
  importId           String
  propertyId         String?
  propertyExternalId String
  earningsMonth      String
  /// When the money lands, which the file states rather than leaving implied.
  payoutMonth        String
  grossCents         Int
  /// Negative, as exported. Charged when a room is re-let.
  bookingFeesCents   Int
  netOfBookingCents  Int
  /// Negative, as exported. 8% of collections net of booking fees.
  serviceFeesCents   Int
  hostEarningsCents  Int
  /// Refunded booking fees and the like: income, but not rent against a bill,
  /// so it stays out of the collection-rate denominator.
  adjustmentsCents   Int
  totalPayoutCents   Int
  /// The account it was paid into, for matching the deposit on the statement.
  payoutAccount      String?

  import   PadSplitImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([propertyExternalId, earningsMonth])
  @@index([propertyId, earningsMonth])
  @@index([payoutMonth])
}

/// What was charged. The month is the month it was raised — the file has no
/// month column — and billId is what a collection line joins back to.
model BilledLine {
  id                 String   @id @default(cuid())
  importId           String
  propertyId         String?
  propertyExternalId String?
  roomExternalId     String?
  roomNumber         String?
  memberId           String?
  memberName         String?
  earningsMonth      String
  billedDate         DateTime @db.Date
  billType           String
  /// membership_dues, promo_room_discount, overdue_balance, and so on.
  reason             String
  /// fee | fine | concession, stated by the export rather than inferred.
  kind               String
  /// As exported: charges negative, concessions positive.
  amountCents        Int
  billId             String

  import   PadSplitImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([billId])
  @@index([propertyId, earningsMonth])
  @@index([memberId])
}

/// What was collected. Joins to a billed line on billId, which is what makes
/// ageing and per-member balances possible.
model CollectionLine {
  id                 String   @id @default(cuid())
  importId           String
  propertyId         String?
  propertyExternalId String?
  roomExternalId     String?
  roomNumber         String?
  memberId           String?
  memberName         String?
  billType           String
  /// collected | adjustment, stated by the export.
  category           String
  /// Gross collected on this line.
  amountCents        Int
  bookingFeeCents    Int
  serviceFeeCents    Int
  hostEarningsCents  Int
  /// The column is labelled "Payout Month" but holds the EARNINGS month, and
  /// is blank while that month is still collecting. Stored raw; earningsMonth
  /// is it where present and the created month where not.
  payoutMonthRaw     String?
  createdDate        DateTime @db.Date
  earningsMonth      String
  billId             String?

  import   PadSplitImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  property Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId, earningsMonth])
  @@index([billId])
  @@index([memberId])
}

/// PadSplit's own total for a month across every property — earnings_table.csv.
///
/// Not per property, which an earlier model of this got wrong. It earns its
/// place as a check: the summary rows for a month should add up to it, and on
/// a real export they do, on all three figures for all eight months.
model PadSplitMonthTotal {
  id               String  @id @default(cuid())
  importId         String
  earningsMonth    String
  /// Stated by the file, so which month is still collecting is never guessed.
  inFlight         Boolean
  collectionsCents Int
  /// Booking fees plus service fees. Negative, as exported.
  expensesCents    Int
  adjustmentsCents Int
  payoutCents      Int

  import PadSplitImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([earningsMonth])
}

/// A category someone added themselves — pest control, pool service, whatever
/// this portfolio turns out to need. Built-in categories live in code; these
/// sit alongside them and behave identically, including at year end, which is
/// why a tax treatment is required rather than optional.
model CustomCategory {
  id           String   @id @default(cuid())
  /// Stable identifier stored on transactions. Derived from the label once and
  /// then never changed, so renaming a category cannot orphan its history.
  key          String   @unique
  label        String
  /// income | not_income | expense
  class        String
  /// Schedule E line, for the year-end report.
  taxLine      String?
  /// income | deductible | capitalizable | not_reportable
  taxTreatment String
  note         String?
  /// Kept out of the pickers without breaking transactions already using it.
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Where a value estimate came from. A number is only as good as its source,
/// so the source is stored beside it rather than assumed.
enum ValuationSource {
  purchase
  appraisal
  broker_opinion
  avm
  owner_estimate
  contract
  sale
}

/// A dated value estimate. Dated, like every other record here, so the history
/// is kept and a property's value can be read as of any month rather than only
/// as of now.
model Valuation {
  id         String          @id @default(cuid())
  propertyId String
  date       DateTime        @db.Date
  valueCents Int
  source     ValuationSource
  notes      String?
  createdAt  DateTime        @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, date])
}

// ── Banking (§7) ─────────────────────────────────────────────────────────────

/// Each property has its own bank account. Everything for that property moves
/// in and out through it — the single most important structural fact in the
/// build (§1), and the reason the file IS the property on import.
model BankAccount {
  id          String  @id @default(cuid())
  propertyId  String
  label       String
  institution String?
  last4       String?
  active      Boolean @default(true)

  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  statements BankStatement[]
  payeeRules PayeeRule[]

  @@index([propertyId])
}

enum StatementStatus {
  /// Parsed but not posted — the balance check has not passed.
  pending
  /// opening + credits − debits = closing. Posted.
  posted
  /// Refused: incomplete or malformed.
  rejected
}

model BankStatement {
  id                   String          @id @default(cuid())
  bankAccountId        String
  periodStart          DateTime        @db.Date
  periodEnd            DateTime        @db.Date
  openingBalanceCents  Int
  closingBalanceCents  Int
  /// Computed as opening + credits − debits. Stored so a failed tie is
  /// inspectable rather than just refused.
  computedClosingCents Int?
  status               StatementStatus @default(pending)
  fileName             String?
  importedAt           DateTime        @default(now())

  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([bankAccountId, periodStart, periodEnd])
}

model BankTransaction {
  id                  String   @id @default(cuid())
  statementId         String
  date                DateTime @db.Date
  description         String
  /// Credits positive, debits negative.
  amountCents         Int
  runningBalanceCents Int?
  categoryKey         String?
  matchedRuleId       String?
  /// True once a human has confirmed the category in the review list.
  confirmed           Boolean  @default(false)
  /// A note for later. One line on a statement rarely says what it was for.
  memo                String?

  /// Set on the pieces of a split. One charge covering two things — supplies
  /// and a capital improvement on the same Home Depot receipt — is kept whole
  /// so the statement still ties, and the pieces carry the categories.
  ///
  /// The rule everywhere else: a row counts toward the books only if nothing
  /// was split out of it. A parent with pieces is a container, not an entry.
  splitParentId String?

  statement   BankStatement     @relation(fields: [statementId], references: [id], onDelete: Cascade)
  splitParent BankTransaction?  @relation("TransactionSplit", fields: [splitParentId], references: [id], onDelete: Cascade)
  splits      BankTransaction[] @relation("TransactionSplit")

  @@index([statementId, date])
  @@index([categoryKey])
  @@index([splitParentId])
}

/// Substring match on description → category. The rule table is what stops
/// this becoming the Stessa experience: after two months the monthly work is a
/// handful of one-offs (§7).
model PayeeRule {
  id            String   @id @default(cuid())
  /// Null applies the rule to every account.
  bankAccountId String?
  match         String
  categoryKey   String
  /// any | debit | credit. The same payee can mean opposite things depending
  /// on which way the money went: a transfer to your own account is a draw
  /// going out and a contribution coming in, and the description is identical.
  direction     String   @default("any")
  priority      Int      @default(0)
  createdAt     DateTime @default(now())

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([bankAccountId])
}

// ── Debt (§8) ────────────────────────────────────────────────────────────────

enum LoanType {
  mortgage
  pml
  heloc
  seller_financed
  other
}

enum LoanStructure {
  fully_amortizing
  interest_only
  interest_only_balloon
  custom
}

enum LoanStatus {
  active
  paid_off
  refinanced
}

/// How often a payment falls due. Private notes are frequently quarterly.
enum PaymentFrequency {
  monthly
  quarterly
  semiannual
  annual
}

model Loan {
  id                         String           @id @default(cuid())
  propertyId                 String
  lender                     String
  type                       LoanType
  lienPosition               Int?
  originalPrincipalCents     Int
  /// Whole-number annual rate: 7.25 means 7.25%.
  ratePercent                Decimal          @db.Decimal(7, 4)
  startDate                  DateTime         @db.Date
  firstPaymentDate           DateTime         @db.Date
  termMonths                 Int?
  maturityDate               DateTime?        @db.Date
  paymentAmountCents         Int?
  paymentFrequency           PaymentFrequency @default(monthly)
  structure                  LoanStructure
  balloonAmountCents         Int?
  paymentDayOfMonth          Int?
  escrowIncluded             Boolean          @default(false)
  escrowCents                Int?
  /// What the servicer actually disburses from escrow in a year. Money paid
  /// INTO escrow is not deductible — the tax and insurance bills the servicer
  /// pays OUT of it are, and those bills never appear as a bank line because
  /// they are settled inside the mortgage payment. Left blank, the year-end
  /// report shows escrow as an unallocated memo instead of guessing.
  escrowTaxAnnualCents       Int?
  escrowInsuranceAnnualCents Int?
  /// A pro-rata debt share is an economic figure, not a legal one. Where this
  /// is set, the maturity ladder shows the WHOLE balance as exposure
  /// alongside the pro-rata share (§3, the debt caveat).
  personallyGuaranteed       Boolean          @default(false)
  status                     LoanStatus       @default(active)
  notes                      String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  property Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([propertyId])
  @@index([maturityDate])
}

model LoanPayment {
  id                  String   @id @default(cuid())
  loanId              String
  date                DateTime @db.Date
  totalCents          Int
  principalCents      Int
  interestCents       Int
  escrowCents         Int      @default(0)
  extraPrincipalCents Int      @default(0)
  /// scheduled = derived from the terms; actual = it really happened.
  source              String   @default("actual")

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, date])
}

// ── Rollups ──────────────────────────────────────────────────────────────────
//
// Materialized and recomputed on every import (§11). Always stored at property
// level and at 100%; the view multiplier is applied at read time, never stored.

model MonthlyPropertyRollup {
  id         String @id @default(cuid())
  propertyId String
  month      String
  /// cash = keyed to when money moved; accrual = keyed to the earnings month.
  /// The two will not agree, and that is the point (§5).
  basis      String

  revenueCents          Int @default(0)
  hostEarningsCents     Int @default(0)
  /// What the platform kept out of the rent it collected. An expense, not a
  /// reduction in revenue — that is where the deduction lives.
  platformFeesCents     Int @default(0)
  pmFeeCents            Int @default(0)
  ownerPaidOpexCents    Int @default(0)
  pmPaidOpexCents       Int @default(0)
  operatingExpenseCents Int @default(0)
  noiCents              Int @default(0)
  depositReceivedCents  Int @default(0)
  /// What the platform says will land, whether or not a statement is in yet.
  expectedDepositCents  Int @default(0)
  /// Actual less expected. Non-zero means the deposit was short, late or wrong.
  depositVarianceCents  Int @default(0)
  debtServiceCents      Int @default(0)
  debtBalanceCents      Int @default(0)
  netCashCents          Int @default(0)

  roomsTotal        Int      @default(0)
  roomsOccupied     Int      @default(0)
  occupancyRate     Decimal? @db.Decimal(7, 3)
  collectionRate    Decimal? @db.Decimal(9, 3)
  delinquencyCents  Int      @default(0)
  trueRoomRateCents Int?

  managementMode  String?
  transitionMonth Boolean  @default(false)
  inFlight        Boolean  @default(false)
  outlier         Boolean  @default(false)
  outlierReason   String?
  /// tied | does_not_tie | awaiting_pm_statement
  tieStatus       String   @default("does_not_tie")
  computedAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, month, basis])
  @@index([month])
}

model MonthlyPortfolioRollup {
  id    String @id @default(cuid())
  month String
  basis String

  revenueCents          Int      @default(0)
  operatingExpenseCents Int      @default(0)
  noiCents              Int      @default(0)
  debtServiceCents      Int      @default(0)
  netCashCents          Int      @default(0)
  roomsTotal            Int      @default(0)
  roomsOccupied         Int      @default(0)
  crossesEntities       Boolean  @default(false)
  computedAt            DateTime @default(now())

  @@unique([month, basis])
}

// ── Deferred (§11) ───────────────────────────────────────────────────────────
//
// Blocked on a real PM statement sample. Modelled now so the reduced-form
// residual has somewhere to land later without the identity changing.

model PMStatement {
  id                  String   @id @default(cuid())
  propertyId          String
  earningsMonth       String
  /// The month the money actually moved. A deposit landing in month N is for
  /// earnings month N−1 — confirm the exact lag against the first statement
  /// before hard-coding it (§5).
  payoutMonth         String?
  grossCollectedCents Int?
  feeChargedCents     Int?
  netRemittedCents    Int?
  fileName            String?
  importedAt          DateTime @default(now())

  property Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lines    PMStatementLine[]

  @@unique([propertyId, earningsMonth])
}

model PMStatementLine {
  id          String    @id @default(cuid())
  statementId String
  date        DateTime? @db.Date
  description String
  categoryKey String?
  amountCents Int

  statement PMStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
}
